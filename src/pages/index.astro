---
import Deck from '../layouts/Deck.astro';
import Slide from '../components/Slide.astro';
import DeckDemo from '../components/DeckDemo.tsx';

const TOTAL = 13;
---

<Deck title="TEAM 2387 · 고1·고2 수학 내신 대비 플랫폼" total={TOTAL}>
  {/* 01 ─────────────────────────────────────────────── */}
  <Slide id="s1" title="표지">
    <div class="kicker">TEAM 2387<span class="sep">/</span>프로토타입 &amp; 비즈니스 모델 발표<span class="sep">/</span>2026.11.20</div>
    <h1 class="h1">
      남들과 같은 문제집은 그만,<br />
      <span class="accent">우리 학교에 나올 문제</span>를 풀자.
    </h1>
    <p class="lead">
      부교재 · 기출 · 학평을 겹쳐 읽고 그 근거로 문항을 생성하는 <b>고1·고2 수학 내신 대비 플랫폼</b>.
      생성 문항과 검수 문항을 함께 주는 것이 핵심입니다.
    </p>

    <div class="rowhead">
      <span class="n">THESIS</span><h3>학교당 5명으로 성립하는 마이크로 내신 SaaS</h3>
      <span class="meta">Commercial due diligence 관점</span>
    </div>
    <div class="rows">
      <div class="row">
        <div class="k">PROTOTYPE</div>
        <div class="v">부교재·기출 입력 → <b>출처 역추적 리포트</b> → 문항 세트 → 해설 → 적중 리포트 <b>5화면</b></div>
      </div>
      <div class="row">
        <div class="k">PROOF</div>
        <div class="v">비학군지 일반고 <span class="ph">3곳</span> 기출로 <b>레시피 유지율 · 적중률 · 교사 판정</b> 백테스팅</div>
      </div>
      <div class="row">
        <div class="k">BUSINESS MODEL</div>
        <div class="v">학기 패스 + 학교별 특강. 학교당 <b>5명이면 손익분기</b>, 10명이면 공헌이익 43%</div>
      </div>
      <div class="row">
        <div class="k">ASK</div>
        <div class="v">3개월 안에 <b>5인 개설 성공률 40%</b>를 확인할 파일럿 파트너</div>
      </div>
    </div>
  </Slide>

  {/* 02 ─────────────────────────────────────────────── */}
  <Slide id="s2" title="시장 공백">
    <div class="kicker">01<span class="sep">/</span>문제</div>
    <h2 class="h2">비학군지 일반고는 "모수가 작아서" 서비스되지 않습니다</h2>
    <p class="sub">
      내신 수요는 있는데, 사람이 학교마다 대응하는 방식으로는 손익분기가 맞지 않습니다.
      마케팅 부족이 아니라 <b>원가 구조의 문제</b>입니다.
    </p>

    <div class="stats" style="margin-top:24px">
      <div>
        <div class="v">1,200곳</div>
        <div class="l">전국 고교 2,387곳 중 <b>비학군지 일반고</b>. 대형사의 영업 반경 밖</div>
      </div>
      <div>
        <div class="v">18명</div>
        <div class="l">학년 180명 기준 <b>5등급제 1등급(상위 10%)</b>. 이 안에서만 승부합니다</div>
      </div>
      <div>
        <div class="v">50명+</div>
        <div class="l">강사·자료·운영 고정비를 덮는 <b>인간 기반 대비의 손익분기</b></div>
      </div>
    </div>

    <div class="rows">
      <div class="row">
        <div class="k">강사 원가</div>
        <div class="v">학교별 특강은 강사·자료·운영비가 <b>학교마다 고정</b>으로 발생 → 학교당 50명 이상 필요</div>
      </div>
      <div class="row">
        <div class="k">모수</div>
        <div class="v">타겟 학교의 1등급은 18명, 최상위 절반은 8~10명 → <b>인간 기반 대비는 구조적 적자</b></div>
      </div>
      <div class="row">
        <div class="k">유통</div>
        <div class="v">대형사는 학군지 거점 오프라인 중심 → 비학군지는 <b>도달 비용이 기대 매출을 넘음</b></div>
      </div>
    </div>
    <p class="foot-note">
      등급 기준: 2025년 고1부터 5등급제. 1등급 = 상위 10%. 이후 모든 계산은 이 기준 하나로 통일합니다.
    </p>
  </Slide>

  {/* 03 ─────────────────────────────────────────────── */}
  <Slide id="s3" title="타이밍과 시장 규모">
    <div class="kicker">02<span class="sep">/</span>타이밍 · 규모</div>
    <h2 class="h2">단가가 무너지며, 20명짜리 시장이 처음 계산에 들어왔습니다</h2>

    <div class="stats" style="margin-top:20px">
      <div>
        <div class="v">5등급제</div>
        <div class="l">2025년 고1부터 적용. 내신 변별력 확대로 <b>학교별 대응이 필수</b></div>
      </div>
      <div>
        <div class="v">200원 / 문항</div>
        <div class="l">AI 변형 제작 단가. 수작업 1만 원+ 대비 붕괴 → <b>소규모 학교도 수익권</b></div>
      </div>
      <div>
        <div class="v">47.7%</div>
        <div class="l">고교생의 주 1회 이상 학습 AI 사용률. <b>도입 장벽이 낮음</b></div>
      </div>
    </div>

    <div class="rowhead"><span class="n">SIZING</span><h3>하향식 7.8조가 아니라, 학교 수에서 곱해 올라간 시장</h3><span class="meta">Bottom-up</span></div>
    <table class="tbl">
      <thead><tr><th>단계</th><th>산식</th><th class="num" style="text-align:right">규모</th></tr></thead>
      <tbody>
        <tr><td>타겟 학교</td><td>전국 고교 2,387곳 중 비학군지 일반고</td><td class="num">1,200곳</td></tr>
        <tr><td>학교당 결제 가능 모수</td><td>1등급 18명 × 정원 해제 후 상위 20%</td><td class="num">36~72명</td></tr>
        <tr><td>학교당 연 매출</td><td>72명 × 2학기 × 객단가 15만</td><td class="num">2,160만</td></tr>
        <tr class="total"><td>SAM</td><td>1,200곳 × 2,160만</td><td class="num pos">약 260억</td></tr>
        <tr><td>3년 SOM (Phase 1)</td><td>120곳 × 2,160만 · 수학 직판</td><td class="num">26억</td></tr>
        <tr><td>Phase 2 — 정원 해제 + 국·영 확장</td><td>480곳 × 모수 ×3</td><td class="num">약 120억</td></tr>
        <tr><td>Phase 3 — 미개설교 B2B + 고3 연계</td><td>학원 라이선스 · 내신·수능 연결</td><td class="num">300억+</td></tr>
      </tbody>
    </table>
    <p class="foot-note">고3·수능은 제외한 보수적 산정. Phase 2·3은 각 단계 검증 KPI 통과 시에만 진입합니다.</p>
  </Slide>

  {/* 04 ─────────────────────────────────────────────── */}
  <Slide id="s4" title="엔진">
    <div class="kicker">03<span class="sep">/</span>구조</div>
    <h2 class="h2">단원 비중이 아니라, 출제자의 변형 레시피를 역추적합니다</h2>
    <p class="sub">
      다항식 42%는 범위표만 봐도 아는 수준입니다. 돈을 내는 이유는 <b>어떻게 변형해서 내는지</b>입니다.
    </p>

    <div class="diagram" style="margin-top:14px">
      <div class="band b3">
        <div class="cell">
          <div class="ck">Input 1</div><div class="ch">부교재 메타DB</div>
          <div class="cd">시중 상위 20종 교재를 미리 태깅(단원·유형·난도). 본문은 저장하지 않음</div>
        </div>
        <div class="cell">
          <div class="ck">Input 2</div><div class="ch">학교 기출</div>
          <div class="cd">촬영·분석 후 즉시 파기. 남는 것은 문항별 출처 태그</div>
        </div>
        <div class="cell">
          <div class="ck">Input 3</div><div class="ch">최근 학평</div>
          <div class="cd">교육청·평가원·EBS. 내신 변형의 원형이 되는 문항군</div>
        </div>
      </div>
      <div class="arrow"><span class="s">trace · match</span><span class="c"></span></div>
      <div class="band">
        <div class="cell engine">
          <div class="ck">Engine</div>
          <div class="ch">출처 역추적 · 변형 레시피 추출</div>
          <div class="cd">
            작년 기말 22문항을 역추적 → <b>부교재 숫자변형 41% · 조건추가 23% · 학평 킬러 차용 18% · 교과서 18%</b>.
            이 레시피를 올해 범위에 그대로 적용해 문항을 만듭니다.
          </div>
        </div>
      </div>
      <div class="arrow"><span class="s">generate · assemble</span><span class="c"></span></div>
      <div class="band b2">
        <div class="cell out">
          <div class="ck">Output 1 · 생성</div><div class="ch">신규 생성 문항 60%</div>
          <div class="cd">레시피 태그를 붙여 생성. 자동 검증 → 교과 검수 → 강사 최종 확인 통과분만 노출</div>
        </div>
        <div class="cell out">
          <div class="ck">Output 2 · 검수</div><div class="ch">검수 문항 40%</div>
          <div class="cd">공공기출 재해설 DB + 대성 비독점 라이선스. 세트의 품질 하한선</div>
        </div>
      </div>
    </div>

    <div class="ph-block">
      <span class="tag-i">검증 필요 — 레시피 지속성</span>
      중간고사에서 뽑은 레시피가 기말에도 남는가? <b>검증 학교 <span class="ph">N곳</span> · 직전→직후 패턴 유지율 <span class="ph">0.00</span> (코사인 유사도) · 표본 <span class="ph">N</span>학기</b>
    </div>
  </Slide>

  {/* 05 ── 백테스팅 (신규) ─────────────────────────────── */}
  <Slide id="s5" title="백테스팅">
    <div class="kicker">04<span class="sep">/</span>실증</div>
    <h2 class="h2">가설이 아니라, 실제 기출로 돌려본 결과입니다</h2>
    <p class="sub">
      <span class="ph">2026 1학기 중간</span> 기출 + 부교재로 레시피를 뽑고, 기말 예상 <span class="ph">60</span>문항을 생성해
      실제 기말 <span class="ph">22</span>문항과 대조했습니다.
    </p>

    <div class="stats" style="margin-top:22px">
      <div>
        <div class="v"><span class="ph">__%</span></div>
        <div class="l"><b>출제 원천 적중률</b> — 실제 문항 중 부교재·학평 변형 출처가 일치 (<span class="ph">__/22</span>)</div>
      </div>
      <div>
        <div class="v"><span class="ph">__%</span></div>
        <div class="l"><b>변형 메커니즘 적중률</b> — 조건 추가·발문 역전 등 <b>변형 기법까지</b> 일치 (<span class="ph">__/22</span>)</div>
      </div>
      <div>
        <div class="v"><span class="ph">__%</span></div>
        <div class="l"><b>교사 블라인드 통과율</b> — 생성 문항 중 "그대로 출제 가능" 판정 (<span class="ph">__/60</span>)</div>
      </div>
    </div>

    <div class="rowhead"><span class="n">SAMPLE</span><h3>비학군지 일반고 검증 결과</h3><span class="meta">학교별 1학기</span></div>
    <table class="tbl">
      <thead>
        <tr><th>학교</th><th>분석 문항</th><th class="num">원천 적중</th><th class="num">메커니즘 적중</th><th class="num">교사 판정</th></tr>
      </thead>
      <tbody>
        <tr><td><span class="ph">A고 · 지역</span></td><td class="num">22</td><td class="num"><span class="ph">__</span></td><td class="num"><span class="ph">__</span></td><td class="num"><span class="ph">__</span></td></tr>
        <tr><td><span class="ph">B고 · 지역</span></td><td class="num">22</td><td class="num"><span class="ph">__</span></td><td class="num"><span class="ph">__</span></td><td class="num"><span class="ph">__</span></td></tr>
        <tr><td><span class="ph">C고 · 지역</span></td><td class="num">22</td><td class="num"><span class="ph">__</span></td><td class="num"><span class="ph">__</span></td><td class="num"><span class="ph">__</span></td></tr>
        <tr class="total"><td>합계 / 평균</td><td class="num">66</td><td class="num pos"><span class="ph">__%</span></td><td class="num pos"><span class="ph">__%</span></td><td class="num pos"><span class="ph">__%</span></td></tr>
      </tbody>
    </table>
    <p class="foot-note">
      지표 정의 — 원천 적중: 출제 문항의 원형이 우리 DB에서 특정됨 · 메커니즘 적중: 변형 기법(조건추가·발문역전·함수합성)까지 일치 ·
      교사 판정: 현직 교사 3인 블라인드, 3점 척도 중 2점 이상.
    </p>
  </Slide>

  {/* 06 ── 스크롤로 5화면을 넘기는 구간 ─────────────────── */}
  <section class="slide scrolly" id="s6" data-title="프로토타입">
    <div class="scrolly-sticky">
      <div class="scrolly-inner">
        <div class="kicker">05<span class="sep">/</span>프로토타입</div>
        <h2 class="h2">스크롤하면 5화면이 차례로 넘어갑니다</h2>
        <p class="sub" style="margin-bottom:0">
          2번 <b>출처 역추적 리포트</b>가 이 제품의 핵심 화면입니다. 계속 스크롤하세요.
        </p>
        <DeckDemo client:load scrolly />
      </div>
    </div>
  </section>

  {/* 07 ─────────────────────────────────────────────── */}
  <Slide id="s7" title="차별점">
    <div class="kicker">06<span class="sep">/</span>차별점</div>
    <h2 class="h2">강자가 3개월 만에 따라 하면 어떻게 되는가</h2>
    <p class="sub">
      기능은 복제됩니다. 복제되지 않는 것은 <b>기존 고객과의 이해상충</b>, 그리고 <b>교사 코호트 단위 파라미터</b>입니다.
    </p>

    <div class="rows" style="margin-top:16px">
      <div class="row">
        <div class="k">매쓰플랫이 못 하는 이유</div>
        <div class="v">매출의 대부분이 <b>학원·교사 B2B</b>. 학원에 파는 회사가 학생에게 직접 "우리 학교 1등급만" 팔면 <b>고객사와 정면 충돌</b> — 전형적 이노베이터 딜레마</div>
      </div>
      <div class="row">
        <div class="k">기술적 차이</div>
        <div class="v">기존 DB는 <b>단원·유형 매칭</b>. 우리는 <b>출제자·코호트별 변형 파라미터</b>(조건 추가 빈도, 발문 역전 습관)를 누적 — 학교 단위로만 학습되는 데이터</div>
      </div>
      <div class="row">
        <div class="k">ChatGPT와의 차이</div>
        <div class="v">내 학교 기출 이력이 없고, <b>수식 환각</b>이 남습니다. 우리는 근거 → 생성 → 3단 검증 → 해설이 한 줄로 연결</div>
      </div>
    </div>

    <table class="tbl">
      <thead><tr><th>대안</th><th>한계</th></tr></thead>
      <tbody>
        <tr><td>매쓰플랫 · 매쓰프로</td><td>9,500개 기관·110만 문항. 그러나 <b>강사용 도구</b>이고 B2C 전환 시 고객사와 충돌</td></tr>
        <tr><td>대형 인강</td><td>전국 공통·고3 중심. <b>우리 학교 범위가 반영되지 않음</b></td></tr>
        <tr><td>학군지 한정 서비스</td><td>일부 지역·학교만 커버. <b>다른 학교 학생은 받을 수 없음</b></td></tr>
      </tbody>
    </table>
  </Slide>

  {/* 08 ─────────────────────────────────────────────── */}
  <Slide id="s8" title="공급망">
    <div class="kicker">07<span class="sep">/</span>공급망</div>
    <h2 class="h2">검수 병목은 '시험 기간'에만 터집니다 — 그래서 미리 만듭니다</h2>

    <div class="stats" style="margin-top:20px">
      <div>
        <div class="v">78.8%</div>
        <div class="l">최상위 모델이 만든 문항 중 <b>풀이·정답·교육적 적절성</b>을 동시에 충족한 비율</div>
      </div>
      <div>
        <div class="v">700원 / 문항</div>
        <div class="l">생성 200 + 검수 500. 검수는 <b>문항당 2~3분 × 시급 1.5만</b> 환산</div>
      </div>
      <div>
        <div class="v">10배</div>
        <div class="l">시험 3주에 몰리는 <b>첨두부하(Peak-to-Average)</b>. 평시 인력으로는 불가</div>
      </div>
    </div>

