---
import Deck from '../layouts/Deck.astro';
import Slide from '../components/Slide.astro';
import Tex from '../components/Tex.astro';
import RevenueChart from '../components/RevenueChart.tsx';
import LeverageChart from '../components/LeverageChart.tsx';
import { machines } from '../lib/anatomy/geometry';

const TOTAL = 13;
---

<Deck title="TEAM 2387 · 내신 적중 큐레이션" total={TOTAL}>
  {/* 01 ─────────────────────────────────────────────── */}
  <Slide id="s1" title="표지">
    <div class="kicker">TEAM 2387<span class="sep">/</span>B2B 내신 큐레이션 SaaS<span class="sep">/</span>2026.11.20</div>
    <h1 class="h1">
      시험에 나올 문제만<br />
      골라주는 <span class="accent">내신 적중 큐레이션</span>
    </h1>
    <p class="tagline">원생 1명인 학교도 완벽하게 대비하는 다학교 로컬 학원 전용 큐레이션 SaaS와 북스토어</p>
    <div class="mobile-classroom iso" data-theme="light" aria-hidden="true">
      <Fragment set:html={machines[7]} />
    </div>
    <p class="lead">
      강사가 밤새 문제를 뒤져야 하는 <b>검색형 문제은행</b>에서, 학교 프린트와 부교재의 원전 결합 구조를 역추적해
      출제 유력 문항만 추려 받는 <b>내신 적중 큐레이션</b>으로 옮깁니다.
    </p>

    <div class="band b3" style="margin-top:20px">
      <div class="cell">
        <div class="ck">과거</div>
        <div class="ch">검색형 문제은행</div>
        <div class="cd">수백 개 필터와 검색창 앞에서 강사가 학교마다 직접 대조합니다</div>
      </div>
      <div class="cell engine">
        <div class="ck">현재</div>
        <div class="ch">출처 계보 큐레이션</div>
        <div class="cd">부교재와 프린트의 복수 원전 결합을 분석해 학교별 예상 세트를 뽑습니다</div>
      </div>
      <div class="cell out">
        <div class="ck">결과</div>
        <div class="ch">원생 1명 학교도 커버</div>
        <div class="cd">다학교 소수 원생 학원이 조교 인건비 없이 맞춤 자료를 확보합니다</div>
      </div>
    </div>

    <div class="point">
      <span class="tag">Investor point</span>
      <div class="b">
        단순 AI 문항 생성 툴이 아닙니다. 로컬 중소 학원의 <b>다학교 자료 제작 병목</b>을 줄이는 <b>B2B 큐레이션 워크플로 플랫폼</b>입니다.
      </div>
    </div>
  </Slide>

  {/* 02 ─────────────────────────────────────────────── */}
  <Slide id="s2" title="문제">
    <div class="kicker">01<span class="sep">/</span>문제</div>
    <h2 class="h2">로컬 중소 학원의 생존은 '학교별 특강'에 달려 있지만,<br />학교당 원생이 1~10명뿐이라 맞춤 자료 제작이 불가능합니다</h2>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-[1.05fr_0.95fr]" style="margin-top:16px">
      <div class="rows" style="margin:0">
        <div class="row">
          <div class="k">현장 구조</div>
          <div class="v">총원 60명급 로컬 수학 학원에 인근 <b>5~8개 일반고</b> 원생 약 35명이 학교당 <b>1~10명</b>씩 나뉘어 등원합니다</div>
        </div>
        <div class="row">
          <div class="k">물리적 한계</div>
          <div class="v">원생 20명 이상인 주력 학교와 달리, 1~3명짜리 학교는 부교재와 프린트 출처를 강사가 직접 대조해야 해 인건비와 시간이 맞지 않습니다</div>
        </div>
        <div class="row">
          <div class="k">기존 문제은행</div>
          <div class="v">단원·유형별 유사문제는 주지만, 학교 프린트가 <b>어느 원전 문항을 합쳐 변형했는지</b> 골라내는 일은 강사에게 남습니다</div>
        </div>
        <div class="row">
          <div class="k">결과</div>
          <div class="v">일반고 참여 학생 1인당 수학 사교육비는 <b>월 39.3만 원</b>(2025 공식 조사)입니다. 자료 부족으로 원생 1명만 이탈해도 타격이 큽니다</div>
        </div>
      </div>

      <div class="mock">
        <div class="mock-h"><b>강사 한 명의 담당 학교</b> 이번 학기 예시</div>
        <div class="mock-b">
          <ol class="rank">
            <li>
              <span class="rk">01</span><span class="t">A고 · 원생 2명</span><span class="p">2</span>
              <span class="why">부교재와 프린트를 따로 대조해야 함</span>
            </li>
            <li>
              <span class="rk">02</span><span class="t">B고 · 원생 1명</span><span class="p">1</span>
              <span class="why">전담 제작 인건비가 수강료를 넘습니다</span>
            </li>
            <li>
              <span class="rk">03</span><span class="t">C고 · 원생 5명</span><span class="p">5</span>
              <span class="why">간신히 손익이 맞는 구간</span>
            </li>
            <li>
              <span class="rk">04</span><span class="t">D고 · 원생 3명</span><span class="p">3</span>
              <span class="why">프린트 배포 시점마다 대응이 밀립니다</span>
            </li>
          </ol>
          <div class="drop">주력 학교는 원생 20명 이상이라 전담 대비가 가능합니다. 나머지 소수 학교가 문제입니다.</div>
        </div>
      </div>
    </div>

    <div class="point">
      <span class="tag">Investor point</span>
      <div class="b">
        전국 교과 학원 86,695곳 가운데 입시·보습 중소 학원이 매 학기 겪는 <b>다학교 소수 원생 커버리지 병목</b>입니다.
        기존 문제은행 SaaS는 다학교 출처 대조 수작업을 해결하지 못했습니다.
      </div>
    </div>
  </Slide>

  {/* 03 ── 시장 규모 (2026 교육기본통계·2025 사교육비·학원등록 실측 반영) ─ */}
  <Slide id="s3" title="시장 규모">
    <div class="kicker">02<span class="sep">/</span>시장 규모</div>
    <h2 class="h2">2026 교육통계와 학원 등록 실측치를 반영한 핵심 시장은<br />SAM 약 2,530곳, 기준 SOM 연 9.0억 원입니다</h2>

    <div class="band b3" style="margin-top:18px">
      <div class="cell">
        <div class="ck">TAM · 고등 수학 수요 시설</div>
        <div class="ch">약 6,750곳 · 연 243억 원</div>
        <div class="cd">일반고 고1·2 수학 학원 수요(약 23.6만 명)를 학원당 원생 35명으로 환산한 규모입니다(매쓰플랫 전체 9,500곳과 정합)</div>
      </div>
      <div class="cell engine">
        <div class="ck">SAM · 로컬 다학교 학원</div>
        <div class="ch">약 2,530곳 · 연 91.0억 원</div>
        <div class="cd">교육부 등록 통계 기준 교습소(33.1%)와 대형·프랜차이즈(20%)를 빼고 다학교 특강 운영 학원(70%)만 남겼습니다</div>
      </div>
      <div class="cell out">
        <div class="ck">기준 SOM · 3년차 10%</div>
        <div class="ch">250곳 · 연 9.0억 원</div>
        <div class="cd">핵심 SaaS만 계산하면 연 8.1억 원입니다. 500곳(18.0억 원)은 과목·채널 확장을 전제한 공격적 목표로 분리합니다</div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-[1.04fr_0.96fr]" style="margin-top:14px">
      <div class="mock">
        <div class="mock-h"><b>산정 근거</b> 공식 통계 실측치와 내부 가정 구분</div>
        <div class="mock-b" style="padding:10px 14px">
          <div class="rows" style="margin:0">
            <div class="row" style="padding:9px 0">
              <div class="k">2026 교육기본통계</div>
              <div class="v">일반고 <b>1,594개교 · 95.2만 명</b> 중 고1·2 약 63.4만 명, 교과 학원 비중 <b>66.9%</b>(교습소 33.1% 실측 제외)</div>
            </div>
            <div class="row" style="padding:9px 0">
              <div class="k">2025 사교육비 조사</div>
              <div class="v">일반고 수학 참여율 <b>47.8%</b>, 일반고 일반교과 대비 학원수강 지출 비중 <b>77.9%</b>(36.7÷47.1만 원)</div>
            </div>
            <div class="row" style="padding:9px 0">
              <div class="k">내부 가정 · 검증</div>
              <div class="v">학원당 고1·2 수학 35명, 중소형 80%, 다학교 특강 70%, 기준 ARPU 연 360만 원(NEIS 등록자료로 교차검증)</div>
            </div>
          </div>
        </div>
      </div>

      <div class="mock">
        <div class="mock-h"><b>단계별 목표</b> 통합 연 360만 원(핵심 324만 원) 기준</div>
        <div class="mock-b" style="padding:10px 14px">
          <table class="tbl" style="margin:0">
            <thead>
              <tr><th>단계</th><th class="num" style="text-align:right">유료 학원</th><th class="num" style="text-align:right">SAM 비중</th><th class="num" style="text-align:right">통합(핵심)</th></tr>
            </thead>
            <tbody>
              <tr><td>초기 검증 (BEP)</td><td class="num">50곳</td><td class="num">2.0%</td><td class="num">1.8억(1.6억)</td></tr>
              <tr><td>시장 확장</td><td class="num">120곳</td><td class="num">4.7%</td><td class="num">4.3억(3.9억)</td></tr>
              <tr class="total"><td>기준 SOM</td><td class="num pos">250곳</td><td class="num pos">9.9%</td><td class="num pos">9.0억(8.1억)</td></tr>
              <tr><td>공격적 확장</td><td class="num">500곳</td><td class="num">19.8%</td><td class="num">18.0억(16.2억)</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="point">
      <span class="tag">Investor point</span>
      <div class="b">
        초기 AI 초안의 부풀린 B2C 시장(3,980억 원)을 폐기하고, <b>2026 교육부 확정 통계와 현실적 학원 요금(월 30만 원)</b>으로 다시 쌓았습니다.
        영어(일반고 참여율 43.6%)와 국어(29.1%) 확장 시 동일 학원 내 추가 과금이 열립니다.
      </div>
    </div>
  </Slide>

  {/* 04 ─────────────────────────────────────────────── */}
  <Slide id="s4" title="가치 제안">
    <div class="kicker">03<span class="sep">/</span>가치 제안</div>
    <h2 class="h2">학원은 소수 원생 학교의 자료 제작에서 해방되고,<br />학생은 우리 학교 시험에 나올 문제만 고밀도로 풉니다</h2>

    <div class="band b3" style="margin-top:22px">
      <div class="cell">
        <div class="ck">B2B · 학원</div>
        <div class="ch">자료 제작에서 해방</div>
        <div class="cd">원생 1~2명 학교도 학교 프린트와 부교재로 선별된 <b>적중 큐레이션 세트</b>를 확보합니다. 강사가 밤새 원전을 찾지 않습니다</div>
      </div>
      <div class="cell engine">
        <div class="ck">엔진</div>
        <div class="ch">학교별 큐레이션</div>
        <div class="cd">프린트의 복수 원전을 역추적하고, 최근 3개년 학교 기출 난이도와 대조해 나올 문항만 남깁니다</div>
      </div>
      <div class="cell out">
        <div class="ck">B2B2C · 학생</div>
        <div class="ch">학습 밀도</div>
        <div class="cd">전국 공통 양치기 대신 우리 학교 기출 경향과 프린트 출처에 맞는 문항만 풉니다. 체감 적중률이 올라갑니다</div>
      </div>
    </div>

    <div class="rows" style="margin-top:14px">
      <div class="row">
        <div class="k">학원이 얻는 것</div>
        <div class="v">출처 대조·문항 선별 수작업 절감 · 담당 학교 수 확대(3개교 → 6개교 이상) · 소수 원생 학교 <b>퇴원 방어</b></div>
      </div>
      <div class="row">
        <div class="k">학생이 얻는 것</div>
        <div class="v">불필요한 양치기 제거 · 시험 직전 복합 변형 고난도 대비 · 우리 학교 기준의 학습 우선순위</div>
      </div>
    </div>

    <div class="point">
      <span class="tag">Investor point</span>
      <div class="b">
        학교 추가 요금(월 3만 원)은 일반고 원생 1명 평균 수학 수강료(월 39.3만 원)의 8% 미만입니다. <b>소수 학교 원생 1명 이탈만 막아도 학원은 구독료를 즉시 회수</b>합니다.
      </div>
    </div>
  </Slide>

  {/* 05 ─────────────────────────────────────────────── */}
  <Slide id="s5" title="학기 루프">
    <div class="kicker">04<span class="sep">/</span>고객 관계</div>
    <h2 class="h2">한 번 내려받고 끝나는 도구가 아니라,<br />학기 초부터 시험 직전까지 학원과 함께 움직입니다</h2>

    <div class="band b3" style="margin-top:20px">
      <div class="cell">
        <div class="ck">Step 1 · 학기 초</div>
        <div class="ch">경향 분석과 부교재 세팅</div>
        <div class="cd">담당 학교를 등록하고 북스토어에서 부교재를 구매하면, 담당 학기의 학교별 출제 경향 리포트가 열립니다</div>
      </div>
      <div class="cell">
        <div class="ck">Step 2 · 학기 중</div>
        <div class="ch">프린트 출처 해부</div>
        <div class="cd">학교 유인물이 나올 때마다 학원이 올리면, 문항별 원전 출처와 변형 계보를 분석합니다</div>
      </div>
      <div class="cell engine">
        <div class="ck">Step 3 · 시험 직전</div>
        <div class="ch">변형문항 +α 전달</div>
        <div class="cd">분석 결과로 핵심 변형문항과 최고난도 대비 문항을 큐레이션해, 학원이 자기 콘텐츠로 학생에게 배포합니다</div>
      </div>
    </div>

    <div class="rowhead"><span class="n">TIMELINE</span><h3>학기 한 번이 곧 계약 한 번입니다</h3><span class="meta">3월·9월 → 중간 → 파이널 → 기말</span></div>
    <div class="rows">
      <div class="row">
        <div class="k">학기 초</div>
        <div class="v">학교 등록 · 부교재 구매 · 기출 경향 리포트 확인</div>
      </div>
      <div class="row">
        <div class="k">중간고사 3주 전</div>
        <div class="v">학교 프린트 업로드가 몰리며 추가 분석 크레딧 수요가 발생합니다</div>
      </div>
      <div class="row">
        <div class="k">시험 직전</div>
        <div class="v">학교별 예상 30문항 세트와 최고난도 보완 문항을 배포합니다</div>
      </div>
      <div class="row">
        <div class="k">기말고사 · 다음 학기</div>
        <div class="v">실제 시험지와 예상 세트를 대조해 학교 프로파일을 갱신하고 기말·다음 학기로 이어집니다</div>
      </div>
    </div>

    <div class="point">
      <span class="tag">Investor point</span>
      <div class="b">
        시험 2주만 쓰고 끊는 도구가 아닙니다. 프린트가 나올 때마다 접속하고 학기마다 데이터가 쌓이는 <b>높은 리텐션 구조</b>입니다.
      </div>
    </div>
  </Slide>

  {/* 06 ── 큐레이션 엔진 (실측 파이프라인·경쟁사 차별화 반영) ─ */}
  <Slide id="s6" title="큐레이션 엔진">
    <div class="kicker">05<span class="sep">/</span>핵심 기술</div>
    <h2 class="h2">키워드로 찾는 검색이 아니라, 업로드 자료와<br />기출의 구조를 비교해 나올 문제만 남깁니다</h2>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-[0.9fr_1.1fr]" style="margin-top:16px">
      <div class="mock">
